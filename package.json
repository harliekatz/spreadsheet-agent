{
  "name": "spreadsheet-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An AI-assisted spreadsheet workspace built on a synthetic dataset, with source references for every generated value.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.2",
    "next": "^16.0.0",
    "papaparse": "^5.5.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.19.0"
  }
}
