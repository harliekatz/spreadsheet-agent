# Spreadsheet Agent
#
# This app has no secrets. It runs entirely in the browser, makes no network
# requests, and reads only the synthetic dataset generated in src/lib/data.ts.
# The file exists to document the shape of a future server-backed version and
# so a reviewer can confirm nothing sensitive is expected here.
#
# Public, safe to commit:
NEXT_PUBLIC_APP_NAME="Spreadsheet Agent"

# Reserved for a future server-side planner. Leave unset for the demo build.
# Any real key belongs in your host's environment settings, never in this file.
# PLANNER_API_URL=
# PLANNER_API_KEY=
